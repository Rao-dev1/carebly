# Copy to .env for local development. Never commit real values.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_SIGNUP_CODE=
DATABASE_PATH=./carebly.db
SESSION_COOKIE_SECURE=0
ENABLE_SCHEDULER=1
REMINDER_HOURS_BEFORE=24
DEFAULT_COUNTRY_CODE=91
TZ=Asia/Kolkata

# Meta WhatsApp Cloud API (leave blank to only log messages)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en

# Public website
CLINIC_NAME=Sunrise Clinic
CLINIC_TAGLINE=Caring for your family's health
CLINIC_ADDRESS=12 MG Road, Pune 411001
CLINIC_PHONE=+91 98765 43210
CLINIC_EMAIL=hello@example.com
CLINIC_HOURS=Mon-Sat: 10:00 - 13:00, 17:00 - 20:00
CLINIC_MAP_EMBED_URL=
CLINIC_WHATSAPP=919876543210
